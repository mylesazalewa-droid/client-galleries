# --- Studio branding ---
STUDIO_NAME="Myles Zalewa"
STUDIO_TAGLINE="Film & photo"
STUDIO_URL=""
STUDIO_EMAIL=""

# --- Google Drive (leave empty to run in demo mode) ---
# The service account's JSON key, pasted whole or base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the parent "Client Galleries" folder (the part after /folders/ in its URL).
DRIVE_ROOT_FOLDER_ID=

# --- Client picks ---
# Google Sheet that receives selections (share it with the service account as Editor).
SELECTIONS_SHEET_ID=
# Optional email ping when a client sends picks (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# --- Security & behaviour ---
# Any long random string. Signs the password cookies.
GALLERY_SECRET=
# true = list unlocked galleries on the home page
SHOW_INDEX=false
# How long folder listings are cached before Drive is checked again
CACHE_SECONDS=60
